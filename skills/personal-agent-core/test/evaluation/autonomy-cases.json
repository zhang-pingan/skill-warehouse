        "source": {
          "records": [
            {
              "id": "private-01",
              "group": "B",
              "amount": 8,
              "active": true
            },
            {
              "id": "private-02",
              "group": "A",
              "amount": 12,
              "active": true
            },
            {
              "id": "private-03",
              "group": "A",
              "amount": 5,
              "active": true
            },
            {
              "id": "private-04",
              "group": "A",
              "amount": 100,
              "active": false
